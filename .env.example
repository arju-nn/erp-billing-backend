PORT=4000
NODE_ENV=development
# Comma-separated list allowed, e.g. http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

DB_HOST=your-service-your-project.e.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
# Set to false only for a local MySQL without SSL
DB_SSL=true
# Aiven CA certificate. Any of: a file path (./certs/ca.pem), the PEM text itself
# (literal \n allowed, handy on Render), or the PEM base64-encoded.
DB_SSL_CA=./certs/ca.pem
DB_LOGGING=false